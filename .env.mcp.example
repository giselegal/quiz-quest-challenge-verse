# MCP Configuration Examples
# Copy this file to .env.local and update with your actual values

# ===== MCP PROTOCOL CONFIGURATION =====

# Environment (development, staging, production)
NODE_ENV=development

# Primary database provider (supabase, sqlite, better-sqlite3)
MCP_PRIMARY_DB=supabase
# Fallback database provider
MCP_FALLBACK_DB=sqlite

# Enable/disable synchronization between providers
MCP_SYNC_ENABLED=true
# Sync strategy (immediate, batch, manual)
MCP_SYNC_STRATEGY=batch

# ===== SUPABASE CONFIGURATION =====
REACT_APP_SUPABASE_URL=https://pwtjuuhchtbzttrzoutw.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB3dGp1dWhjaHRienR0cnpvdXR3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTIzNDQ0NjAsImV4cCI6MjA2NzkyMDQ2MH0.EP0qLHBZK8nyxcod0FEVRQln4R_yVSWEGQwuIbJfP_w

# Service Role Key (for server-side operations only)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===== SQLITE CONFIGURATION =====
REACT_APP_SQLITE_PATH=./dev.db
SQLITE_WAL_MODE=true

# For server environments
SQLITE_MEMORY_MODE=false
SQLITE_READONLY=false

# ===== BETTER-SQLITE3 CONFIGURATION =====
BETTER_SQLITE_PATH=./dev.db
BETTER_SQLITE_WAL=true
BETTER_SQLITE_CACHE_SIZE=2000

# ===== MCP LOGGING & MONITORING =====

# Log level (debug, info, warn, error)
MCP_LOG_LEVEL=info

# Enable performance monitoring
MCP_PERFORMANCE_MONITORING=true

# Health check interval (seconds)
MCP_HEALTH_CHECK_INTERVAL=30

# Connection timeout (milliseconds)
MCP_CONNECTION_TIMEOUT=5000

# ===== MCP RETRY CONFIGURATION =====

# Maximum number of retries
MCP_MAX_RETRIES=3

# Base delay for exponential backoff (milliseconds)
MCP_RETRY_BASE_DELAY=1000

# Maximum delay for exponential backoff (milliseconds)
MCP_RETRY_MAX_DELAY=10000

# Backoff multiplier
MCP_RETRY_BACKOFF_MULTIPLIER=2

# Enable jitter in retry delays
MCP_RETRY_JITTER=true

# ===== MCP ERROR HANDLING =====

# Enable error reporting
MCP_ERROR_REPORTING=true

# Error reporting service (sentry, bugsnag, none)
MCP_ERROR_SERVICE=none

# Sentry DSN (if using Sentry)
MCP_SENTRY_DSN=your_sentry_dsn_here

# ===== ANALYTICS CONFIGURATION =====

# Facebook Pixel ID
FACEBOOK_PIXEL_ID=123456789012345
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_TEST_EVENT_CODE=TEST12345

# Hotmart Webhook
HOTMART_WEBHOOK_SECRET=your_hotmart_webhook_secret_here

# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===== SESSION & SECURITY =====

# Session secret for server-side sessions
SESSION_SECRET=your_super_secret_session_key_here

# CORS settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ===== DEVELOPMENT SETTINGS =====

# Enable debug mode
DEBUG=true

# Enable mock data
ENABLE_MOCK_DATA=false

# Database seeding
SEED_DATABASE=false

# ===== PRODUCTION SETTINGS =====

# Database connection pooling
DB_POOL_MIN=2
DB_POOL_MAX=10

# Cache settings
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# Rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== FEATURE FLAGS =====

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable A/B testing
ENABLE_AB_TESTING=false

# Enable real-time sync
ENABLE_REALTIME_SYNC=true

# Enable offline support
ENABLE_OFFLINE_SUPPORT=false

# ===== BACKUP & RECOVERY =====

# Automatic backup interval (hours)
AUTO_BACKUP_INTERVAL=24

# Backup retention period (days)
BACKUP_RETENTION_DAYS=30

# Backup storage (local, s3, gcs)
BACKUP_STORAGE=local

# S3 configuration (if using S3)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-backup-bucket

# ===== INSTRUCTIONS =====
#
# 1. BASIC SETUP:
#    - Copy this file to .env.local
#    - Update SUPABASE_URL and SUPABASE_ANON_KEY with your actual values
#    - Set MCP_PRIMARY_DB based on your environment needs
#
# 2. DEVELOPMENT:
#    - Use MCP_PRIMARY_DB=sqlite for faster local development
#    - Set DEBUG=true for detailed logging
#    - Use ENABLE_MOCK_DATA=true for testing without real data
#
# 3. PRODUCTION:
#    - Use MCP_PRIMARY_DB=supabase for production
#    - Set appropriate retry and timeout values
#    - Enable error reporting and monitoring
#    - Configure backup settings
#
# 4. TESTING:
#    - Use NODE_ENV=test
#    - Set MCP_PRIMARY_DB=sqlite with :memory: path
#    - Disable external integrations
#
# 5. STAGING:
#    - Mirror production settings but with test data
#    - Enable debug logging for troubleshooting
#    - Use shorter health check intervals

# ===== VALIDATION RULES =====
#
# Required variables:
# - NODE_ENV
# - MCP_PRIMARY_DB
# - REACT_APP_SUPABASE_URL (if using Supabase)
# - REACT_APP_SUPABASE_ANON_KEY (if using Supabase)
#
# Optional but recommended:
# - MCP_FALLBACK_DB
# - SESSION_SECRET
# - MCP_LOG_LEVEL
#
# Environment-specific:
# - Development: DEBUG, ENABLE_MOCK_DATA
# - Production: Error reporting, Backup settings, Rate limiting
# - Testing: In-memory databases, Disabled external services